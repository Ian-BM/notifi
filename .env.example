# Notifi — Environment Variables
# Copy this file to .env and fill in your real values
# NEVER commit the .env file

# Django
SECRET_KEY=your-secret-key-here-generate-a-random-one
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,notifi.co.tz

# Server (production only)
SERVER_IP=your-contabo-server-ip

# Database
DB_NAME=notifi_db
DB_USER=notifi_user
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432

# Beem Africa API (get from engage.beem.africa)
BEEM_API_KEY=your-beem-api-key
BEEM_SECRET_KEY=your-beem-secret-key

# Support contacts (shown in platform UI)
SUPPORT_PHONE=255XXXXXXXXX
SUPPORT_WHATSAPP=255XXXXXXXXX
